# Copy this file to .env.local and fill in your own values.

# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
# Set it to your real domain after deploying, e.g. https://lucid-lamiakajal.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to read stored messages through the admin API.
# Send it in the "x-api-key" request header. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: Google Search Console verification token (the content="..." value of the
# google-site-verification meta tag). Helps your site appear in Google search results.
# GOOGLE_SITE_VERIFICATION=

# Optional: directory for the built-in JSON data store.
# Defaults to ./.data locally and /tmp/lucid-data on Vercel (temporary there).
# DATA_DIR=./.data

# Optional: max write requests per minute per IP (contact form and newsletter).
# RATE_LIMIT_MAX=5

# Optional: only used if you follow docs/MONGODB.md to switch to MongoDB.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MONGODB_DB=lucid
